# Database Configuration
# Option 1: Local PostgreSQL (recommended for offline development)
DATABASE_URL="postgresql://username:password@localhost:5432/awt_inventory?schema=public"

# Option 2: Railway.app (free tier, requires internet)
# Get your connection string from Railway dashboard
# DATABASE_URL="postgresql://postgres:password@containers-us-west-123.railway.app:5432/railway"

# Option 3: Prisma Dev (easiest - automatic local PostgreSQL)
# Just run: npx prisma dev
# DATABASE_URL="<generated by prisma dev>"

# JWT Secret (generate a random string for production)
JWT_SECRET="your-secret-key-change-this-in-production"

# Server Configuration
PORT=3000
NODE_ENV="development"
