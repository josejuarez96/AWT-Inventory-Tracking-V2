# Production Environment Variables
# Copy this to .env on your production server, or set via Railway dashboard.

# Database — provided automatically by Railway PostgreSQL add-on
DATABASE_URL=

# JWT secret — generate a strong random value:
#   openssl rand -base64 32
JWT_SECRET=

# Server port — Railway sets this automatically via $PORT
PORT=3000

# Environment
NODE_ENV=production

# CORS — set to your Vercel frontend URL
FRONTEND_URL=https://your-app.vercel.app

# Optional: override login rate limit (requests per 15-second window, default 10)
# LOGIN_RATE_LIMIT=10
