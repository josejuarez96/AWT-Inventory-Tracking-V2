// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int       @id @default(autoincrement())
  username      String    @unique @db.VarChar(50)
  passwordHash  String    @map("password_hash")
  fullName      String    @map("full_name") @db.VarChar(100)
  role          String    @db.VarChar(20) // 'admin' or 'user'
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  lastLoginAt   DateTime? @map("last_login_at")

  transactions          Transaction[]
  cycleCountsCreated    CycleCount[] @relation("cycleCountCreator")
  cycleCountsAssigned   CycleCount[] @relation("cycleCountAssignee")
  cycleCountsPosted     CycleCount[] @relation("cycleCountPoster")
  bomsCreated           Bom[]             @relation("bomCreator")
  productionOrders      ProductionOrder[] @relation("productionCreator")
  productionLinesPosted   ProductionOrderLine[] @relation("linePostUser")
  productionLinesVoided   ProductionOrderLine[] @relation("lineVoidUser")
  productionLinesReversed ProductionOrderLine[] @relation("lineReverseUser")
  optionGroupsCreated     OptionGroup[]         @relation("optionGroupCreator")
  optionGroupsUpdated     OptionGroup[]         @relation("optionGroupUpdater")
  optionPackagesCreated   OptionPackage[]       @relation("optionPackageCreator")
  optionPackagesUpdated   OptionPackage[]       @relation("optionPackageUpdater")

  @@map("users")
}

model Vendor {
  id            Int       @id @default(autoincrement())
  vendorCode    String    @unique @map("vendor_code") @db.VarChar(50)
  vendorName    String    @map("vendor_name") @db.VarChar(200)
  contactPerson String?   @map("contact_person") @db.VarChar(100)
  phone         String?   @db.VarChar(20)
  email         String?   @db.VarChar(100)
  paymentTerms  String?   @map("payment_terms") @db.VarChar(50)
  notes         String?
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")

  transactions  Transaction[]
  defaultItems  Item[] @relation("defaultVendorItems")
  itemVendors   ItemVendor[]

  @@map("vendors")
}

model Item {
  id              Int       @id @default(autoincrement())
  itemCode        String    @unique @map("item_code") @db.VarChar(50)
  description     String
  category        String?   @db.VarChar(100)
  unitOfMeasure   String    @default("EA") @map("unit_of_measure") @db.VarChar(20)
  minQuantity     Decimal?  @map("min_quantity") @db.Decimal(10, 2)
  maxQuantity     Decimal?  @map("max_quantity") @db.Decimal(10, 2)
  safetyStock     Decimal   @default(0) @map("safety_stock") @db.Decimal(10, 2)
  standardCost    Decimal?  @map("standard_cost") @db.Decimal(10, 2)
  lastPurchaseCost Decimal? @map("last_purchase_cost") @db.Decimal(10, 2)
  defaultVendorId Int?      @map("default_vendor_id")
  itemType        String    @default("RAW") @map("item_type") @db.VarChar(20) // 'RAW', 'FINISHED', 'OTHER'
  isActive        Boolean   @default(true) @map("is_active")
  notes           String?
  createdAt       DateTime  @default(now()) @map("created_at")

  allowDecimalQty Boolean   @default(false) @map("allow_decimal_qty")
  stockLength     Decimal?  @map("stock_length") @db.Decimal(10, 4)

  defaultVendor   Vendor?   @relation("defaultVendorItems", fields: [defaultVendorId], references: [id])
  additionalVendors ItemVendor[]
  transactions    Transaction[]
  cycleCountLines CycleCountLine[]
  bomsAsFinishedGood             Bom[]             @relation("bomFinishedGood")
  bomLinesAsComponent            BomLine[]         @relation("bomLineItem")
  productionOrdersAsFinishedGood ProductionOrder[] @relation("productionFinishedGood")
  optionLines                    OptionLine[]

  @@map("items")
}

model Transaction {
  id              Int       @id @default(autoincrement())
  transactionType String    @map("transaction_type") @db.VarChar(20) // 'RECEIPT', 'ADJUSTMENT', 'TRANSFER', 'OPENING_BALANCE', 'CONSUMPTION', 'PRODUCTION'
  itemId          Int       @map("item_id")
  vendorId        Int?      @map("vendor_id")
  location        String    @db.VarChar(50) // 'ADEL' or 'CALHOUN'
  quantity        Decimal   @db.Decimal(10, 2)
  unitCost        Decimal?  @map("unit_cost") @db.Decimal(10, 2)
  referencePrice  Decimal?  @map("reference_price") @db.Decimal(10, 2)
  invoiceNumber   String?   @map("invoice_number") @db.VarChar(100)
  transactionDate DateTime  @map("transaction_date") @db.Date
  notes           String?
  createdBy       Int       @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at")

  productionOrderId Int?   @map("production_order_id")
  batchId           String? @map("batch_id") @db.VarChar(36)

  item              Item              @relation(fields: [itemId], references: [id])
  vendor            Vendor?           @relation(fields: [vendorId], references: [id])
  user              User              @relation(fields: [createdBy], references: [id])
  cycleCountLine    CycleCountLine?
  productionOrder   ProductionOrder?  @relation(fields: [productionOrderId], references: [id])

  @@index([itemId])
  @@index([itemId, location])
  @@index([transactionDate])
  @@index([transactionType])
  @@index([batchId])
  @@map("transactions")
}

model CycleCount {
  id          Int       @id @default(autoincrement())
  countNumber String    @unique @map("count_number") @db.VarChar(20)
  location    String    @db.VarChar(50)
  status      String    @default("DRAFT") @db.VarChar(20)
  blindCount  Boolean   @default(false) @map("blind_count")
  notes       String?
  createdBy   Int       @map("created_by")
  assignedTo  Int?      @map("assigned_to")
  postedBy    Int?      @map("posted_by")
  postedAt    DateTime? @map("posted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  creator     User      @relation("cycleCountCreator", fields: [createdBy], references: [id])
  assignee    User?     @relation("cycleCountAssignee", fields: [assignedTo], references: [id])
  poster      User?     @relation("cycleCountPoster", fields: [postedBy], references: [id])
  lines       CycleCountLine[]

  @@index([status])
  @@index([location])
  @@map("cycle_counts")
}

model CycleCountLine {
  id            Int       @id @default(autoincrement())
  cycleCountId  Int       @map("cycle_count_id")
  itemId        Int       @map("item_id")
  systemQty     Decimal   @map("system_qty") @db.Decimal(10, 2)
  countedQty    Decimal?  @map("counted_qty") @db.Decimal(10, 2)
  unitCost      Decimal?  @map("unit_cost") @db.Decimal(10, 2)
  variance      Decimal?  @db.Decimal(10, 2)
  varianceValue Decimal?  @map("variance_value") @db.Decimal(10, 2)
  adjustmentId  Int?      @unique @map("adjustment_id")
  createdAt     DateTime  @default(now()) @map("created_at")

  cycleCount    CycleCount  @relation(fields: [cycleCountId], references: [id])
  item          Item        @relation(fields: [itemId], references: [id])
  adjustment    Transaction? @relation(fields: [adjustmentId], references: [id])

  @@unique([cycleCountId, itemId])
  @@index([cycleCountId])
  @@index([itemId])
  @@map("cycle_count_lines")
}

model Bom {
  id              Int       @id @default(autoincrement())
  bomCode         String    @unique @map("bom_code") @db.VarChar(50)
  name            String    @db.VarChar(200)
  finishedGoodId  Int       @map("finished_good_id")
  status          String    @default("DRAFT") @map("status") @db.VarChar(20) // 'DRAFT', 'ACTIVE', 'RETIRED'
  notes           String?
  createdBy       Int       @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  finishedGood     Item              @relation("bomFinishedGood", fields: [finishedGoodId], references: [id])
  creator          User              @relation("bomCreator", fields: [createdBy], references: [id])
  lines            BomLine[]
  optionGroups     OptionGroup[]
  productionOrders ProductionOrder[]

  @@index([status])
  @@index([finishedGoodId])
  @@map("boms")
}

model BomLine {
  id          Int      @id @default(autoincrement())
  bomId       Int      @map("bom_id")
  itemId      Int      @map("item_id")
  quantityPer Decimal  @map("quantity_per") @db.Decimal(10, 4)
  scrapPercent Decimal? @map("scrap_percent") @db.Decimal(5, 2)
  cutDetails  Json?    @map("cut_details")
  notes       String?
  sortOrder   Int      @default(0) @map("sort_order")

  bom         Bom     @relation(fields: [bomId], references: [id], onDelete: Cascade)
  item        Item    @relation("bomLineItem", fields: [itemId], references: [id])

  @@unique([bomId, itemId])
  @@index([bomId])
  @@map("bom_lines")
}

model ProductionOrder {
  id               Int       @id @default(autoincrement())
  orderNumber      String    @unique @map("order_number") @db.VarChar(20)
  bomId            Int?      @map("bom_id")
  finishedGoodId   Int       @map("finished_good_id")
  location         String    @db.VarChar(50)
  quantityProduced Decimal   @map("quantity_produced") @db.Decimal(10, 2)
  totalCost        Decimal   @map("total_cost") @db.Decimal(12, 2)
  totalQuantity    Decimal?  @map("total_quantity") @db.Decimal(10, 2)
  status           String    @default("OPEN") @db.VarChar(20) // 'OPEN', 'PARTIAL', 'COMPLETED'
  orderType        String    @default("STAGED") @map("order_type") @db.VarChar(20) // 'STAGED' or 'INSTANT'
  notes            String?
  hasDeviations    Boolean   @default(false) @map("has_deviations")
  deviationNotes   String?   @map("deviation_notes")
  vinReference     String?   @map("vin_reference") @db.VarChar(500)
  /// JSON structure: {
  ///   bomId, bomCode,
  ///   selections: [{ groupId, groupName, selectionType, packageId, packageName, quantity }],
  ///   deviations: [{ itemId, itemCode, quantityPer, notes }],
  ///   componentSnapshot: [{ itemId, itemCode, quantityPer, scrapPercent, cutDetails, effectiveQty, unitCost, source }]
  /// }
  configurationSnapshot Json? @map("configuration_snapshot")
  configurationKey      String? @map("configuration_key") @db.Text
  createdBy        Int       @map("created_by")
  createdAt        DateTime  @default(now()) @map("created_at")

  bom              Bom?      @relation(fields: [bomId], references: [id])
  finishedGood     Item      @relation("productionFinishedGood", fields: [finishedGoodId], references: [id])
  creator          User      @relation("productionCreator", fields: [createdBy], references: [id])
  transactions     Transaction[]
  lines            ProductionOrderLine[]

  @@index([finishedGoodId])
  @@index([location])
  @@index([status])
  @@index([orderType])
  @@index([configurationKey])
  @@map("production_orders")
}

model ProductionOrderLine {
  id                 Int       @id @default(autoincrement())
  productionOrderId  Int       @map("production_order_id")
  lineNumber         Int       @map("line_number")
  status             String    @default("STAGED") @db.VarChar(20) // 'STAGED', 'POSTED', 'VOIDED', 'REVERSED'
  componentSnapshot  Json      @map("component_snapshot") // [{itemId, itemCode, description, quantityPer}]
  lineCost           Decimal   @default(0) @map("line_cost") @db.Decimal(12, 2)
  postedAt           DateTime? @map("posted_at")
  postedBy           Int?      @map("posted_by")
  voidedAt           DateTime? @map("voided_at")
  voidedBy           Int?      @map("voided_by")
  reversedAt         DateTime? @map("reversed_at")
  reversedBy         Int?      @map("reversed_by")
  notes              String?
  batchId            String?   @map("batch_id") @db.VarChar(36)
  createdAt          DateTime  @default(now()) @map("created_at")

  productionOrder    ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  poster             User?           @relation("linePostUser", fields: [postedBy], references: [id])
  voider             User?           @relation("lineVoidUser", fields: [voidedBy], references: [id])
  reverser           User?           @relation("lineReverseUser", fields: [reversedBy], references: [id])

  @@unique([productionOrderId, lineNumber])
  @@index([productionOrderId])
  @@index([status])
  @@map("production_order_lines")
}

model ItemVendor {
  id       Int     @id @default(autoincrement())
  itemId   Int     @map("item_id")
  vendorId Int     @map("vendor_id")
  notes    String?

  item     Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  vendor   Vendor  @relation(fields: [vendorId], references: [id])

  @@unique([itemId, vendorId])
  @@index([itemId])
  @@map("item_vendors")
}

model OptionGroup {
  id            Int       @id @default(autoincrement())
  bomId         Int       @map("bom_id")
  name          String    @db.VarChar(100)
  category      String?   @db.VarChar(50)
  selectionType String    @map("selection_type") @db.VarChar(20) // 'PICK_ONE' or 'PICK_MANY'
  required      Boolean   @default(false)
  sortOrder     Int       @default(0) @map("sort_order")
  createdBy     Int       @map("created_by")
  updatedBy     Int?      @map("updated_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  bom           Bom       @relation(fields: [bomId], references: [id], onDelete: Cascade)
  creator       User      @relation("optionGroupCreator", fields: [createdBy], references: [id])
  updater       User?     @relation("optionGroupUpdater", fields: [updatedBy], references: [id])
  packages      OptionPackage[]

  @@unique([bomId, name])
  @@index([bomId])
  @@map("option_groups")
}

model OptionPackage {
  id             Int       @id @default(autoincrement())
  optionGroupId  Int       @map("option_group_id")
  name           String    @db.VarChar(100)
  isDefault      Boolean   @default(false) @map("is_default")
  status         String    @default("DRAFT") @db.VarChar(20) // 'DRAFT', 'ACTIVE', 'RETIRED'
  allowQuantity  Boolean   @default(false) @map("allow_quantity")
  minQuantity    Int       @default(1) @map("min_quantity")
  maxQuantity    Int?      @map("max_quantity")
  sortOrder      Int       @default(0) @map("sort_order")
  notes          String?
  createdBy      Int       @map("created_by")
  updatedBy      Int?      @map("updated_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  optionGroup    OptionGroup @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)
  creator        User        @relation("optionPackageCreator", fields: [createdBy], references: [id])
  updater        User?       @relation("optionPackageUpdater", fields: [updatedBy], references: [id])
  lines          OptionLine[]

  @@unique([optionGroupId, name])
  @@index([optionGroupId])
  @@index([status])
  @@index([optionGroupId, isDefault])
  @@map("option_packages")
}

model OptionLine {
  id              Int       @id @default(autoincrement())
  optionPackageId Int       @map("option_package_id")
  itemId          Int       @map("item_id")
  action          String    @db.VarChar(10) // 'ADD' or 'REMOVE'
  quantityPer     Decimal   @map("quantity_per") @db.Decimal(10, 4)
  scrapPercent    Decimal?  @map("scrap_percent") @db.Decimal(5, 2)
  cutDetails      Json?     @map("cut_details")
  sortOrder       Int       @default(0) @map("sort_order")
  notes           String?

  optionPackage   OptionPackage @relation(fields: [optionPackageId], references: [id], onDelete: Cascade)
  item            Item          @relation(fields: [itemId], references: [id])

  @@unique([optionPackageId, itemId, action])
  @@index([optionPackageId])
  @@map("option_lines")
}
